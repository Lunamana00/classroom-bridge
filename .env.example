# auto: use Jev when TYPESAFE_API_KEY is nonempty, otherwise installed Codex CLI,
#       otherwise lexical demo retrieval.
# jev: require TYPESAFE_API_KEY and use Jev only.
# codex: require Codex CLI, reporting an error if it cannot be found.
#        This mode ignores TYPESAFE_API_KEY.
# demo: never invoke Codex or Jev; useful for walkthroughs and automated checks.
CLASSROOM_MODE=auto

# Optional Jev connection. Keep the key in your local, gitignored .env only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Codex uses the existing login; no Jev API key is needed in codex mode.
# An absolute executable path is useful for desktop MCP clients.
CODEX_BIN=codex
# Leave empty to use the CLI default model. Personal config is not inherited.
CODEX_MODEL=

# Relative paths are resolved from the project directory, for both web and MCP.
CLASSROOM_DB=data/classroom.sqlite
