# auto: GPT selects from all approved, source-backed concepts when a key is set.
# Without a key, auto uses the lexical demo.
# codex: OpenAI Responses API using CODEX_MODEL (no CLI required).
# jev: FactChat Decisions API using JEV_MODEL via the OpenAI SDK.
# demo: no question-judgment API calls.
CLASSROOM_MODE=auto
# concepts: default for auto/codex; requires extracted and teacher-approved concepts.
# lexical: legacy word retrieval plus the configured evidence judge.
# jev and demo always keep the lexical retrieval path.
CLASSROOM_RETRIEVAL=concepts

# Keep secrets in gitignored .env.local. OPENAI_API_KEY is also accepted.
OPEN_API_KEY=
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CODEX_MODEL=gpt-6-luna
# Jev uses /decisions/ with state/questions instead of /responses.
JEV_MODEL=jev-1.14.0

# Upload preprocessing prepares drafts; teacher approval enables concept search.
# auto requires a key
# and a non-demo CLASSROOM_MODE; api explicitly enables it even in demo mode.
# disabled marks uploads as requiring setup; request extraction after enabling.
CONCEPT_EXTRACTION_MODE=auto
CONCEPT_MODEL=gpt-6-luna

# Relative paths resolve from the project directory for both web and MCP.
CLASSROOM_DB=data/classroom.sqlite

# Google OIDC login. Secrets stay in .env.local.
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
CLASSROOM_BASE_URL='http://127.0.0.1:8000'
# Only these verified Google emails may create/manage courses.
CLASSROOM_TEACHER_EMAILS=''
# Optional stable signing secret; otherwise generated once in the local database.
CLASSROOM_SESSION_SECRET=''

# Additional exact browser origins for bearer-authenticated MCP (comma separated).
# The app origin, https://chatgpt.com and https://chat.openai.com are included.
CLASSROOM_MCP_ALLOWED_ORIGINS=
